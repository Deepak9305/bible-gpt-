# GROQ_API_KEY: Required by the serverless /api/chat route.
GROQ_API_KEY="MY_GROQ_API_KEY"

# VITE_APP_URL: Required only for native builds that call the hosted chat API.
# Example: https://biblenova.vercel.app
VITE_APP_URL="MY_APP_URL"

# Canonical site URL used by native builds when VITE_APP_URL is not set.
VITE_SITE_URL="https://biblenova.vercel.app"

# Supabase Auth: required for email/password and Google sign-in.
VITE_SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
VITE_SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_KEY"

# Web OAuth client ID used by native Google Sign-In and Supabase Google OAuth.
VITE_GOOGLE_CLIENT_ID="1083543499729-3rrelit5mm4jno7jfogpnaceh9inlgu4.apps.googleusercontent.com"

# Optional: override native AdMob banner units without changing source.
VITE_ADMOB_ANDROID_BANNER_ID="ca-app-pub-7381421031784616/6798345893"
VITE_ADMOB_IOS_BANNER_ID="ca-app-pub-7381421031784616/6798345893"

# Optional: set to "true" in native debug builds to force Google test ads.
VITE_ADMOB_TEST_ADS="false"
